ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional — defaults to claude-opus-5-5. Use claude-sonnet-5-5 or
# claude-haiku-5-5 for lower cost/latency.
# ANTHROPIC_MODEL=claude-opus-5-5

# Google OAuth — create credentials at https://console.cloud.google.com/
# Authorized redirect URI to add: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Change this to a long random string in production
SECRET_KEY=dev-secret-change-in-production
